# Copy to backend/.env and fill in your own values. Never commit the real .env.
DB_NAME=ride_sharing_db
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432

# Optional — SMS OTP. Without these the app runs in demo mode.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional — Razorpay Payment Gateway (UPI / Cards / Escrow Route)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere
